<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
<!--    <bean id="myBean" class="org.example.demo.GreetingService"></bean>-->

    <bean id="EmailNotificationServices" class="org.example.looseCoupling.EmailNotificationServices"></bean>
<bean id="SmsNotificationServices" class="org.example.looseCoupling.SmsNotificationServices"></bean>
    <bean id="UserServiceEmail" class="org.example.looseCoupling.UserServices">
        <property name="notification" ref="EmailNotificationServices"></property>
    </bean>


    <bean id="UserServiceSms" class="org.example.looseCoupling.UserServices">
        <property name="notification" ref="SmsNotificationServices"></property>
<!--    setter ki help se propery ka use kiya h
-->
    </bean>


</beans>